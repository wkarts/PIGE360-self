# Modelo comum. Gere o arquivo real com scripts/configure.py e mantenha-o fora do Git.
APP_ENV=production
APP_URL=https://escola.exemplo.com.br
APP_BIND=127.0.0.1
APP_PORT=58080
APP_IMAGE=ghcr.io/wkarts/pige360-self:latest
APP_PULL_POLICY=always
APP_SECRET_KEY=
SETUP_TOKEN=
POSTGRES_IMAGE=ghcr.io/wkarts/pige360-self-postgres:17-bookworm
POSTGRES_DB=pige360
POSTGRES_USER=pige360
POSTGRES_PASSWORD=
ALLOWED_HOSTS=escola.exemplo.com.br,localhost,127.0.0.1
COOKIE_SECURE=true
MAX_UPLOAD_MB=10
MAX_PHOTO_MB=5
STORAGE_BACKEND=local
STORAGE_BUCKET=pige360-documents
STORAGE_ENDPOINT_URL=
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_USE_SSL=true
STORAGE_AUTO_CREATE_BUCKET=true
STORAGE_FORCE_PATH_STYLE=true
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
TZ=America/Bahia
INTEGRATION_ENCRYPTION_KEY=
INTEGRATION_TIMEOUT_SECONDS=15
CONNECT_API_BASE_URL=
CONNECT_API_KEY=
CONNECT_ALLOWED_HOSTS=
CONNECT_ALLOW_PRIVATE=false
PORTAL_SESSION_HOURS=12
PORTAL_MAX_FILES=20
PORTAL_MAX_STORAGE_MB=50
WORKER_POLL_SECONDS=5
BANK_RECONCILE_INTERVAL_SECONDS=900
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_SECURITY=starttls
TRUSTED_PROXY_IPS=
COMPOSE_PROJECT_NAME=pige360-self-dockge-production
