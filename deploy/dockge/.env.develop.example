# Modelo comum. Gere o arquivo real com scripts/configure.py e mantenha-o fora do Git.
APP_ENV=development
APP_URL=https://dev.escola.exemplo.com.br
APP_BIND=127.0.0.1
APP_PORT=58081
APP_IMAGE=ghcr.io/wkarts/pige360-self:develop
APP_PULL_POLICY=always
MAIL_AGENT_IMAGE=ghcr.io/wkarts/pige360-self-mail-agent:develop
SOGO_IMAGE=ghcr.io/wkarts/pige360-self-sogo:develop
APP_SECRET_KEY=
SETUP_TOKEN=
POSTGRES_IMAGE=ghcr.io/wkarts/pige360-self-postgres:17-bookworm
POSTGRES_DB=pige360_develop
POSTGRES_USER=pige360
POSTGRES_PASSWORD=
ALLOWED_HOSTS=dev.escola.exemplo.com.br,localhost,127.0.0.1
EMBED_ALLOWED_ORIGINS=
COOKIE_SECURE=true
MAX_UPLOAD_MB=10
MAX_PHOTO_MB=5
LEGACY_IMPORT_MAX_MB=128
# Portabilidade em producao: habilite somente durante manutencao autorizada.
PORTABILITY_ENABLED=false
SIGNATURE_TRUST_ROOTS_DIR=/data/trust-roots
# Integração oficial opcional; requer credenciais próprias homologadas.
GOVBR_SIGNATURE_ENABLED=false
GOVBR_PUBLIC_SERVICE_APPROVED=false
GOVBR_LOGIN_UNICO_READY=false
GOVBR_LOGIN_CLIENT_ID=
GOVBR_LOGIN_CLIENT_SECRET=
GOVBR_LOGIN_BASE_URL=
GOVBR_SIGNATURE_CLIENT_ID=
GOVBR_SIGNATURE_CLIENT_SECRET=
GOVBR_SIGNATURE_REDIRECT_URI=
GOVBR_SIGNATURE_OAUTH_BASE_URL=
GOVBR_SIGNATURE_API_BASE_URL=
STORAGE_BACKEND=local
STORAGE_BUCKET=pige360-documents
STORAGE_ENDPOINT_URL=
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_USE_SSL=true
STORAGE_AUTO_CREATE_BUCKET=true
STORAGE_FORCE_PATH_STYLE=true
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
TZ=America/Bahia
INTEGRATION_ENCRYPTION_KEY=
INTEGRATION_TIMEOUT_SECONDS=15
CONNECT_PAIRING_TIMEOUT_SECONDS=75
CONNECT_API_BASE_URL=
CONNECT_API_KEY=
# Opcional. Vazio = permitir somente o hostname exato de CONNECT_API_BASE_URL.
# Preencha para uma allowlist ainda mais restrita, separando múltiplos hosts por vírgula.
CONNECT_ALLOWED_HOSTS=
CONNECT_ALLOW_PRIVATE=false
PORTAL_SESSION_HOURS=12
PORTAL_MAX_FILES=20
PORTAL_MAX_STORAGE_MB=50
WORKER_POLL_SECONDS=5
BANK_RECONCILE_INTERVAL_SECONDS=900
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_SECURITY=starttls
SOGO_UPSTREAM_URL=http://sogo
MAIL_AGENT_SHARED_KEY=
SOGO_DB_PASSWORD=
SOGO_SMTP_SERVER=
TRUSTED_PROXY_IPS=
COMPOSE_PROJECT_NAME=pige360-self-dockge-develop

# Leitura local de documentos: worker separado, mesma imagem GHCR.
OCR_MAX_UPLOAD_MB=8
OCR_RETENTION_HOURS=24
OCR_TIMEOUT_SECONDS=120
OCR_CPUS=1.0
OCR_MEMORY_LIMIT=1g
