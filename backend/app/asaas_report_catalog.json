  "statistics": {
    "title": "Estatísticas de cobranças",
    "group": "Conta e resultados",
    "description": "Quantidade, valor bruto e valor líquido consolidados pela API para os filtros escolhidos. O período se refere ao campo de data selecionado; o total de cobranças não é o saldo disponível.",
    "endpoint": "/finance/payment/statistics",
    "kind": "summary",
    "dates": {"dueDate": "Vencimento", "dateCreated": "Criação", "estimatedCreditDate": "Crédito previsto"},
    "filters": [
      {"key": "status", "label": "Situação", "type": "select", "options": {"PENDING": "Pendente", "CONFIRMED": "Confirmado", "RECEIVED": "Recebido", "OVERDUE": "Vencido"}},
      {"key": "billingType", "label": "Forma de pagamento", "type": "select", "options": {"BOLETO": "Boleto", "CREDIT_CARD": "Cartão de crédito", "PIX": "Pix", "DEBIT_CARD": "Cartão de débito", "TRANSFER": "Transferência", "DEPOSIT": "Depósito"}},
      {"key": "customer", "label": "ID do cliente no Asaas", "type": "identifier", "required": false},
      {"key": "externalReference", "label": "Referência externa", "type": "text"},
      {"key": "anticipated", "label": "Antecipação", "type": "select", "options": {"true": "Antecipadas", "false": "Não antecipadas"}}
    ],
    "booleans": ["anticipated"],
    "columns": [
      {"key": "quantity", "label": "Quantidade de cobranças", "type": "integer", "visible": true},
      {"key": "value", "label": "Valor bruto", "type": "money", "visible": true},
      {"key": "netValue", "label": "Valor líquido", "type": "money", "visible": true}
    ]
  },
  "split_summary": {
    "title": "Resumo de splits",
    "group": "Splits",
    "description": "Valores de splits a receber e a enviar informados pela conta no momento da consulta. Para conferir as operações, utilize as listas de splits recebidos ou enviados.",
    "endpoint": "/finance/split/statistics",
    "kind": "summary",
    "filters": [],
    "columns": [
      {"key": "income", "label": "A receber", "type": "money", "visible": true},
      {"key": "value", "label": "A enviar", "type": "money", "visible": true}
    ]
  },
  "splits_received": {
    "title": "Splits recebidos",
    "group": "Splits",
    "description": "Valores destinados à conta, a receber ou já recebidos. Confira a situação de cada split para distinguir pendência de liquidação.",
    "endpoint": "/payments/splits/received",
    "kind": "list",
    "filters": [
      {"key": "paymentId", "label": "ID da cobrança no Asaas", "type": "identifier", "required": false},
