{
  "statement": {
    "title": "Extrato da conta Asaas",
    "group": "Conta e resultados",
    "description": "Movimentações que alteram o saldo da conta Asaas. Recebimentos, tarifas, transferências e estornos aparecem em lançamentos próprios; os identificadores permitem conferir a operação de origem.",
    "endpoint": "/financialTransactions",
    "kind": "list",
    "dates": {"date": "Movimentação"},
    "range": ["startDate", "finishDate"],
    "filters": [
      {"key": "order", "label": "Ordenação", "type": "select", "options": {"asc": "Mais antigos primeiro", "desc": "Mais recentes primeiro"}}
    ],
    "defaults": {"order": "asc"},
    "columns": [
      {"key": "date", "label": "Data", "type": "date", "visible": true},
      {"key": "type", "label": "Natureza", "type": "text", "visible": true},
      {"key": "description", "label": "Descrição", "type": "text", "visible": true},
      {"key": "value", "label": "Valor", "type": "money", "visible": true},
      {"key": "balance", "label": "Saldo após lançamento", "type": "money", "visible": true},
      {"key": "id", "label": "Lançamento", "type": "text", "visible": true},
      {"key": "paymentId", "label": "Cobrança", "type": "text", "visible": false},
      {"key": "transferId", "label": "Transferência", "type": "text", "visible": false},
      {"key": "anticipationId", "label": "Antecipação", "type": "text", "visible": false},
      {"key": "billId", "label": "Conta paga", "type": "text", "visible": false},
      {"key": "splitId", "label": "Split", "type": "text", "visible": false}
    ]
  },
  "payments": {
    "title": "Cobranças e recebimentos",
    "group": "Cobranças",
    "description": "Consulte recebimentos, pendências, vencimentos e valores líquidos. Confirmado indica pagamento confirmado; Recebido indica crédito recebido. Em parcelamentos, cada linha pode ser uma parcela. Esta consulta não registra baixa na escola.",
    "endpoint": "/payments",
    "kind": "list",
    "dates": {"paymentDate": "Pagamento", "dueDate": "Vencimento", "dateCreated": "Criação", "estimatedCreditDate": "Crédito previsto"},
    "filters": [
      {"key": "status", "label": "Situação", "type": "select", "options": {"PENDING": "Pendente", "CONFIRMED": "Confirmado", "RECEIVED": "Recebido", "OVERDUE": "Vencido", "RECEIVED_IN_CASH": "Recebido em dinheiro", "REFUNDED": "Estornado", "REFUND_REQUESTED": "Estorno solicitado", "REFUND_IN_PROGRESS": "Estorno em andamento", "CHARGEBACK_REQUESTED": "Chargeback solicitado", "CHARGEBACK_DISPUTE": "Chargeback em disputa", "AWAITING_CHARGEBACK_REVERSAL": "Aguardando reversão de chargeback", "DUNNING_REQUESTED": "Negativação solicitada", "DUNNING_RECEIVED": "Recebido após negativação", "AWAITING_RISK_ANALYSIS": "Em análise de risco"}},
      {"key": "billingType", "label": "Forma de pagamento", "type": "select", "options": {"BOLETO": "Boleto", "PIX": "Pix", "CREDIT_CARD": "Cartão de crédito", "UNDEFINED": "Forma a definir"}},
      {"key": "customer", "label": "ID do cliente no Asaas", "type": "identifier", "required": false},
      {"key": "externalReference", "label": "Referência externa", "type": "text"},
      {"key": "installment", "label": "ID do parcelamento", "type": "identifier", "required": false},
      {"key": "subscription", "label": "ID da assinatura", "type": "identifier", "required": false},
      {"key": "anticipated", "label": "Antecipação", "type": "select", "options": {"true": "Antecipadas", "false": "Não antecipadas"}}
    ],
    "booleans": ["anticipated"],
    "columns": [
      {"key": "id", "label": "Cobrança", "type": "text", "visible": true},
      {"key": "customer", "label": "Cliente no Asaas", "type": "text", "visible": true},
      {"key": "status", "label": "Situação", "type": "status", "visible": true},
      {"key": "billingType", "label": "Forma de pagamento", "type": "status", "visible": true},
      {"key": "value", "label": "Valor", "type": "money", "visible": true},
      {"key": "netValue", "label": "Valor líquido", "type": "money", "visible": true},
      {"key": "dueDate", "label": "Vencimento", "type": "date", "visible": true},
      {"key": "paymentDate", "label": "Pagamento", "type": "date", "visible": true},
      {"key": "dateCreated", "label": "Criação", "type": "date", "visible": false},
      {"key": "creditDate", "label": "Crédito", "type": "date", "visible": false},
      {"key": "estimatedCreditDate", "label": "Crédito previsto", "type": "date", "visible": false},
      {"key": "installment", "label": "Parcelamento", "type": "text", "visible": false},
      {"key": "installmentNumber", "label": "Número da parcela", "type": "integer", "visible": false},
      {"key": "subscription", "label": "Assinatura", "type": "text", "visible": false},
      {"key": "externalReference", "label": "Referência externa", "type": "text", "visible": false},
      {"key": "description", "label": "Descrição", "type": "text", "visible": false}
    ]
  },
  "balance": {
    "title": "Saldo atual",
    "group": "Conta e resultados",
    "description": "Saldo da conta Asaas no momento da consulta. Para investigar uma data passada, use o extrato e o saldo informado em cada lançamento.",
