-:root{color-scheme:light;--primary:var(--pige360-petroleum,#006D77);--primary-dark:#005b63;--ink:var(--pige360-navy,#0D1B2A);--muted:#65788a;--border:#e2e9ee;--surface:#fff;--background:var(--pige360-light,#F2F4F7);--teal-soft:#e9f6f4;font-family:Inter,Arial,Helvetica,sans-serif;font-size:14px;line-height:1.5;color:var(--ink);background:var(--background)}*{box-sizing:border-box}body{margin:0}button,input,select,textarea{font:inherit}button,a,input,select,textarea{outline-offset:3px}button:focus-visible,a:focus-visible,input:focus-visible,select:focus-visible,textarea:focus-visible{outline:2px solid var(--primary)}button{cursor:pointer}button:disabled{cursor:not-allowed;opacity:.55}a{color:inherit;text-decoration:none}h1,h2,h3,p{margin:0}h1{font-size:29px;line-height:1.25;letter-spacing:-.7px}h2{font-size:19px;line-height:1.4;letter-spacing:-.25px}h3{font-size:15px}p+p{margin-top:8px}strong{font-weight:650}small{font-size:12px}td small,.list-row small,.guardian-card small,.checklist-item small{display:block;color:var(--muted);margin-top:3px}.muted{color:var(--muted)}.small{font-size:12px}.mono{font-family:ui-monospace,monospace}.preserve{white-space:pre-wrap;overflow-wrap:anywhere}.wide{grid-column:1/-1}.grow{flex:1;min-width:0}.faded{opacity:.58}.spaced{margin-top:22px}.truncate{max-width:320px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.divider{height:1px;background:var(--border);margin:22px 0}.eyebrow{font-size:10px;letter-spacing:1.7px;font-weight:750;color:var(--primary);margin-bottom:8px}.brand-line{display:flex;align-items:center;gap:11px;font-size:20px;letter-spacing:-.6px}.brand-symbol{display:grid;place-items:center;flex:none;width:38px;height:38px;background:var(--primary);color:#fff;font-size:15px;font-weight:750;border-radius:11px;letter-spacing:-1px}.brand-line .muted{font-weight:450}.dot{display:inline-block;width:7px;height:7px;border-radius:50%;background:#16a085;flex:none}.btn{display:inline-flex;align-items:center;justify-content:center;gap:10px;min-height:40px;padding:10px 16px;border:1px solid transparent;border-radius:8px;font-size:13px;font-weight:650;transition:background .15s;white-space:nowrap}.btn-primary{background:var(--primary);color:#fff}.btn-primary:hover{background:var(--primary-dark)}.btn-secondary{background:#fff;border-color:var(--border);color:var(--ink)}.btn-secondary:hover{background:#f8fafb}.small-button{min-height:32px;padding:6px 10px;font-size:12px}.link-button{background:none;border:0;padding:3px;color:var(--primary);font-size:12px;font-weight:650}.link-button:hover{text-decoration:underline}.danger-text{color:#b33748}.icon-button{background:none;border:0;display:grid;place-items:center;min-width:32px;min-height:36px;font-size:23px;color:var(--muted);border-radius:6px}.icon-button:hover{background:var(--background)}.full{width:100%}.actions{display:flex;gap:9px;align-items:center;flex-wrap:wrap}.actions.compact{gap:8px}.auth-layout{display:grid;grid-template-columns:1fr 1fr;min-height:100vh}.auth-intro{background:linear-gradient(145deg,#e9f5f3 0%,#f3f8fa 75%);padding:48px 8%;display:flex;flex-direction:column;justify-content:space-between;gap:55px}.auth-copy{max-width:480px;padding:65px 0}.auth-copy h1{font-size:48px;line-height:1.15;letter-spacing:-1.8px;margin:18px 0 22px}.auth-copy>p:not(.eyebrow){font-size:17px;color:var(--muted);line-height:1.8}.auth-features{display:flex;flex-direction:column;gap:18px;padding-top:42px;color:var(--primary);font-weight:550}.auth-panel{display:flex;align-items:center;justify-content:center;background:white;padding:45px 35px;flex-direction:column}.auth-form{width:100%;max-width:370px;display:flex;flex-direction:column;gap:20px}.auth-form h2{font-size:27px}.auth-form>p.muted{margin-top:-11px}.setup-form{max-width:630px}.setup-form .form-grid{gap:12px 18px}.field{display:flex;flex-direction:column;gap:7px;color:#334d60;font-weight:550;font-size:12px}.field input,.field select,.field textarea,.filter-bar input,.filter-bar select{width:100%;border:1px solid #d9e2e9;border-radius:7px;min-height:41px;background:#fff;color:var(--ink);padding:10px 12px;font-size:13px;box-shadow:0 1px 2px #172b3a03}.field input::placeholder,.filter-bar input::placeholder{color:#93a1af}.field input:focus,.field select:focus,.field textarea:focus{border-color:#5aa9a9}.field select[multiple]{min-height:110px}.field textarea{resize:vertical}.field input[type=file]{padding:8px}.field.checkbox-field{flex-direction:row;align-items:center;min-height:40px;gap:10px}.field input[type=checkbox]{appearance:auto;width:17px;min-height:17px;height:17px;accent-color:var(--primary)}.required{color:#b75055}.form-grid{display:grid;grid-template-columns:1fr 1fr;gap:20px}.alert{display:flex;gap:12px;align-items:center;justify-content:space-between;border:1px solid;border-radius:8px;padding:12px 15px;margin-bottom:17px;font-size:13px;white-space:pre-line}.alert button{background:transparent;border:0;color:inherit}.alert.error{background:#fff3f4;border-color:#f3d2d8;color:#9d3041}.alert.success{background:#effaf4;border-color:#cce8d9;color:#277452}.alert.warning{background:#fff8eb;border-color:#f4e0b4;color:#8c6519}.alert.info{background:#edf6fa;border-color:#d3e5ef;color:#376d86}.workspace{display:flex;min-height:100vh}.sidebar{width:244px;position:fixed;inset:0 auto 0 0;background:white;border-right:1px solid var(--border);padding:30px 18px 18px;display:flex;flex-direction:column;z-index:30;overflow-y:auto}.sidebar>.brand-line{padding:0 7px;margin-bottom:39px;font-size:21px}.sidebar-label{font-size:9px;letter-spacing:1.5px;color:#81909d;font-weight:700;padding:0 14px;margin:9px 0 12px}.sidebar nav{display:flex;flex-direction:column;gap:4px;margin-bottom:23px}.sidebar nav a{display:flex;align-items:center;gap:11px;padding:10px 13px;border-radius:8px;font-size:12px;font-weight:550;color:#52687b;position:relative}.sidebar nav a:hover{background:#f5f8fa}.sidebar nav a.active{background:var(--teal-soft);color:var(--primary);font-weight:700}.sidebar nav a.active:after{content:'';position:absolute;width:4px;height:16px;background:var(--primary);border-radius:3px;right:10px}.nav-icon{font-size:19px;line-height:1;width:24px;text-align:center;font-weight:400}.sidebar-footer{margin-top:auto;padding:17px 13px 0;border-top:1px solid var(--border);font-size:12px;color:var(--muted)}.sidebar-footer .dot{margin-right:6px}.sidebar-footer small{display:block;font-size:10px;margin:7px 0 0 15px}.main-column{margin-left:244px;width:calc(100% - 244px);min-width:0}.topbar{height:85px;border-bottom:1px solid var(--border);background:white;padding:15px 36px;display:flex;align-items:center;justify-content:space-between;gap:16px;position:sticky;top:0;z-index:20}.school-switch{display:flex;flex-direction:column;min-width:0;gap:2px}.school-switch>span{font-size:9px;letter-spacing:1.3px}.school-switch select{max-width:380px;border:0;padding:2px 22px 2px 0;font-weight:650;color:#284252;background:white;font-size:14px;text-overflow:ellipsis}.topbar-actions{display:flex;align-items:center;gap:16px}.online-chip{display:flex;align-items:center;gap:6px;border:1px solid #dceae3;border-radius:20px;padding:4px 9px;font-size:10px;color:#508068}.online-chip.offline{color:#92651e;border-color:#eddeb7}.offline .dot{background:#c0923e}.avatar{object-fit:cover;overflow:hidden;width:34px;height:34px;border-radius:10px;background:#edf4f6;color:#426678;display:grid;place-items:center;font-size:11px;font-weight:700;flex:none}.avatar.large{width:64px;height:64px;font-size:23px;background:#e9f6f4;color:var(--primary);border-radius:16px}.user-avatar{border:0;border-radius:50%;background:#e7f2f0;color:var(--primary);font-size:12px}.user-caption{text-align:right;line-height:1.4}.user-caption strong{display:block;font-size:11px}.user-caption small{font-size:10px;color:var(--muted)}.menu-button{display:none}.main-content{max-width:1660px;margin:auto;padding:30px 36px 18px}.page-header{display:flex;justify-content:space-between;align-items:center;gap:20px;margin-bottom:25px}.breadcrumb{font-size:10px;color:#7f919f;margin-bottom:9px}.page-subtitle{font-size:12px;color:var(--muted);margin-top:8px}.welcome-card{border:1px solid #dbeae7;background:linear-gradient(115deg,#f2faf8,#f4f8fc);border-radius:13px;padding:28px 32px;display:flex;justify-content:space-between;align-items:center;gap:28px;margin-bottom:23px;overflow:hidden}.welcome-card h2{font-size:26px;line-height:1.3;letter-spacing:-.65px}.welcome-card p:not(.eyebrow){font-size:12px;color:var(--muted);max-width:410px;margin-top:11px;line-height:1.7}.welcome-card .actions{margin-top:21px}.welcome-art{background:#ffffffb8;padding:23px 27px;border:1px solid #dfebe8;border-radius:12px;width:210px;transform:rotate(4deg);position:relative;box-shadow:0 12px 30px #1f575c08;margin-right:17px}.welcome-art>span{font-size:9px;letter-spacing:2px;color:#73a29b}.welcome-art strong{font-size:21px;line-height:1.7;display:block;margin-top:9px;color:#4c7a76;font-weight:550}.welcome-art i{position:absolute;right:-18px;bottom:16px;width:42px;height:42px;border-radius:12px;background:var(--primary);color:white;font-size:26px;font-style:normal;text-align:center;transform:rotate(-4deg)}.stats-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:17px;margin-bottom:23px}.stat-card{position:relative;border:1px solid var(--border);background:white;border-radius:11px;padding:20px;min-width:0}.stat-card>span{font-size:11px;color:var(--muted)}.stat-card strong{display:block;font-size:30px;letter-spacing:-1px;margin:9px 0 3px}.stat-card small{font-size:10px;color:#8394a3}.stat-card i{position:absolute;right:17px;top:17px;font-style:normal;font-size:18px;background:#eaf6f3;color:#388b80;width:32px;height:32px;border-radius:8px;display:grid;place-items:center}.stat-card i.amber{background:#fff7e8;color:#ba9347}.dashboard-grid{display:grid;grid-template-columns:1.65fr 1fr;gap:23px;align-items:start}.panel{background:white;border:1px solid var(--border);border-radius:11px;min-width:0;overflow:hidden}.panel-header{padding:20px 22px;display:flex;align-items:center;justify-content:space-between;gap:14px;border-bottom:1px solid #edf1f4}.panel-header h2{font-size:15px}.attention-panel{padding:23px}.attention-panel h2{font-size:18px;margin:8px 0 17px}.attention-panel>button{display:flex;align-items:center;justify-content:space-between;text-align:left;width:100%;background:none;border:0;border-bottom:1px solid #edf1f4;padding:17px 0;font-size:12px;color:#334f62}.attention-panel>button:last-child{border:0}.attention-panel small{display:block;font-size:10px;color:#8c9aa6;margin-top:3px}.attention-panel b{background:#f0f6f6;color:var(--primary);padding:4px 9px;border-radius:6px}.table-scroll{overflow-x:auto}table{border-collapse:collapse;width:100%;font-size:12px;text-align:left}th{background:#f9fbfc;font-size:9px;letter-spacing:.8px;text-transform:uppercase;color:#82929f;font-weight:650;padding:13px 17px;white-space:nowrap;border-bottom:1px solid var(--border)}td{padding:16px 17px;border-bottom:1px solid #eef2f5;color:#405b6d;vertical-align:middle}td strong{color:#284251;font-size:12px}td small{font-size:10px}tbody tr:last-child td{border-bottom:0}tbody tr:hover{background:#fcfdfd}.clickable{cursor:pointer}.person-cell{display:flex;align-items:center;gap:12px}.badge{display:inline-flex;align-items:center;border-radius:6px;padding:4px 8px;font-size:10px;font-weight:650;background:#edf2f6;color:#697d8c;white-space:nowrap}.badge.active,.badge.validated,.badge.completed,.badge.waived{background:#eaf6ef;color:#408064}.badge.draft,.badge.pending,.badge.waiting,.badge.open,.badge.suspended{background:#fff6e7;color:#a08239}.badge.received,.badge.in_progress{background:#edf5fb;color:#527e9f}.badge.rejected,.badge.expired{background:#fff0f1;color:#b4616d}.empty-state{text-align:center;padding:46px 25px;color:var(--muted)}.empty-state>span{display:block;font-size:31px;color:#c0cdd6;margin-bottom:12px}.empty-state h3{color:#5c7182;font-size:14px;margin-bottom:5px}.empty-state p{font-size:12px}.content-footer{display:flex;align-items:center;justify-content:space-between;gap:15px;font-size:9px;color:#95a3af;border-top:1px solid var(--border);margin-top:38px;padding:16px 0 0}.filter-bar{display:flex;align-items:center;gap:12px;margin:0 0 17px}.panel>.filter-bar{padding:20px;margin:0}.filter-bar select{max-width:430px}.search-field{display:flex;align-items:center;gap:8px;position:relative;width:100%;max-width:460px}.search-field>span{position:absolute;left:13px;color:#8799a6;font-size:23px}.search-field input{padding-left:38px}.pagination{display:flex;align-items:center;justify-content:space-between;padding:15px 20px;border-top:1px solid var(--border);font-size:11px;color:var(--muted)}.pagination>div{display:flex;gap:7px}.tabs{display:flex;gap:4px;border-bottom:1px solid var(--border);overflow:auto;margin:0 0 23px}.tabs button{padding:14px 15px;font-size:12px;white-space:nowrap;background:none;border:0;border-bottom:2px solid transparent;color:#718696}.tabs button.active{border-bottom-color:var(--primary);color:var(--primary);font-weight:700}.student-banner{display:flex;align-items:center;gap:18px;background:white;border:1px solid var(--border);border-radius:11px;padding:25px;margin-bottom:10px}.student-banner h2{font-size:21px}.student-banner p{color:var(--muted);font-size:12px;margin-top:5px}.data-grid{display:grid;grid-template-columns:1fr 1fr;gap:24px 40px;padding:26px;margin:0}.data-grid dt{color:#8393a0;font-size:10px;margin-bottom:5px}.data-grid dd{margin:0;font-size:13px;color:#385364}.panel-footer{border-top:1px solid var(--border);padding:18px 25px;display:flex;justify-content:space-between;gap:15px;align-items:center}.guardian-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:17px;padding:22px}.guardian-card{border:1px solid var(--border);padding:20px;border-radius:9px}.guardian-card h3{margin:12px 0 6px}.guardian-card p{font-size:11px;color:var(--muted)}.pills{display:flex;gap:5px;flex-wrap:wrap;margin:14px 0}.section-actions{display:flex;align-items:center;justify-content:space-between;gap:15px;margin-bottom:20px}.checklist-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:11px;margin:15px 0 23px}.checklist-item{border:1px solid var(--border);border-radius:8px;background:white;padding:14px;display:flex;align-items:center;gap:11px}.checklist-item strong{font-size:11px}.checklist-item small{font-size:10px}.check-ok,.check-pending{width:27px;height:27px;border-radius:50%;display:grid;place-items:center;font-weight:650;flex:none}.check-ok{color:#478568;background:#eaf6ef}.check-pending{background:#fff5e4;color:#ae8940}.list-row{display:flex;align-items:center;justify-content:space-between;padding:16px 22px;border-bottom:1px solid #eef2f5;font-size:12px}.timeline-item{padding:20px 24px;display:flex;gap:13px;border-bottom:1px solid #eef2f5}.timeline-item strong{font-size:12px}.timeline-item p{font-size:12px;color:var(--muted);margin:4px 0}.timeline-item small{font-size:10px;color:#8da0ae;display:block;margin-top:5px}.timeline-dot{width:9px;height:9px;border-radius:50%;background:#80aaa8;margin-top:5px;flex:none}.school-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:20px}.school-card{padding:25px}.school-card h2{font-size:21px;margin-bottom:12px}.school-card p{font-size:12px}.school-card .btn{margin-top:18px}.modal-backdrop{position:fixed;inset:0;background:#142c4159;backdrop-filter:blur(3px);z-index:100;display:flex;align-items:center;justify-content:center;padding:24px}.modal{width:100%;max-width:680px;max-height:92vh;overflow:auto;background:white;border-radius:14px;box-shadow:0 24px 80px #152e4133}.modal-wide{max-width:830px}.modal-header{position:sticky;top:0;z-index:2;background:white;padding:21px 26px;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid var(--border)}.modal-header .eyebrow{margin-bottom:3px;font-size:9px}.modal-body{padding:25px 26px}.modal-footer{position:sticky;bottom:0;background:white;display:flex;align-items:center;gap:10px;border-top:1px solid var(--border);padding:18px 26px}.modal-footer>span{margin-right:auto;font-size:10px}.enrollment-summary{background:#f3f8f8;padding:20px;border-radius:9px;margin-bottom:24px}.enrollment-summary h3{display:inline-block;margin-right:15px;font-size:20px}.enrollment-summary p{font-size:12px;color:var(--muted);margin-top:10px}.movement-actions{margin:23px 0}.loading-screen{display:grid;place-content:center;justify-items:center;min-height:100vh;gap:15px}.loading-strip{padding:10px 15px;background:#edf5f9;color:#557a8d;font-size:12px;border-radius:7px;margin-bottom:15px}.sidebar-shade{display:none}
