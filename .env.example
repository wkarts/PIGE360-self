# Gere .env com: python scripts/configure.py
APP_ENV=production
APP_URL=http://localhost:58080
APP_BIND=127.0.0.1
APP_PORT=58080
APP_IMAGE=pige360-self:0.3.0
APP_SECRET_KEY=
SETUP_TOKEN=
POSTGRES_IMAGE=ghcr.io/wkarts/pige360-self-postgres:17-bookworm
POSTGRES_DB=pige360
POSTGRES_USER=pige360
# Use valor URL-safe. O gerador usa secrets.token_urlsafe.
POSTGRES_PASSWORD=
ALLOWED_HOSTS=localhost,127.0.0.1
COOKIE_SECURE=false
MAX_UPLOAD_MB=10
MAX_PHOTO_MB=5
STORAGE_BACKEND=local
STORAGE_BUCKET=pige360-documents
STORAGE_ENDPOINT_URL=
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_USE_SSL=true
STORAGE_AUTO_CREATE_BUCKET=true
STORAGE_FORCE_PATH_STYLE=true
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
TZ=America/Bahia

# Chave Fernet persistente. Gere com configure.py ou prepare-upgrade.py.
INTEGRATION_ENCRYPTION_KEY=
INTEGRATION_TIMEOUT_SECONDS=15
# Hostnames exatos (sem https://), separados por vírgula.
CONNECT_ALLOWED_HOSTS=
CONNECT_ALLOW_PRIVATE=false
PORTAL_SESSION_HOURS=12
PORTAL_MAX_FILES=20
PORTAL_MAX_STORAGE_MB=50
WORKER_POLL_SECONDS=5
BANK_RECONCILE_INTERVAL_SECONDS=900
# E-mail transacional: verificação de contato e recuperação de senha.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_SECURITY=starttls

# IP/CIDR estrito do proxy autorizado; vazio não confia em X-Forwarded-For.
TRUSTED_PROXY_IPS=
